{
  "_README": "Sample CloudPrint configuration: HTTP transport for inbound print jobs, while a device still publishes telemetry to SQS. Demonstrates that the print transport and per-device output transport are independent. AWS credentials are still required because the device output targets SQS. Documentation only; NOT loaded at runtime.",
  "CloudPrint": {
    "Transport": "http",

    "PrinterName": "Zebra_ZP500",
    "ApiUrl": "https://api.example.com/print/jobs",
    "AckUrl": "https://api.example.com/print/jobs",
    "ApiHeaderName": "X-Api-Key",
    "ApiHeaderValue": "replace-with-secret",
    "HttpPollTimeoutSeconds": 30,

    "PdfRenderDpi": 300,
    "PdfFitMode": "Margins",

    "Region": "us-east-1",
    "AwsAccessKeyId": "AKIA...",
    "AwsSecretAccessKey": "...",

    "Station": "packing-pc-02",
    "DevicePollIntervalMs": 500,
    "DeviceStableOnly": true,
    "Devices": [
      {
        "Name": "scale-packing",
        "Type": "serial-scale",
        "Protocol": "generic",
        "ComPort": "COM3",
        "BaudRate": 9600,
        "LineEnding": "crlf",
        "PollMode": "stream",
        "Output": {
          "Transport": "sqs",
          "QueueUrl": "https://sqs.us-east-1.amazonaws.com/123456789012/cloudprint-packing-pc-02-scale-packing"
        }
      }
    ]
  }
}
